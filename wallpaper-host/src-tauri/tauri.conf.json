{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "壁纸盒子",
  "mainBinaryName": "wallpaper-box",
  "version": "0.12.0",
  "identifier": "local.screen-garden.wallpaper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "manager",
        "visible": false,
        "focus": false,
        "title": "壁纸盒子 · 壁纸管理",
        "width": 1080,
        "height": 760,
        "minWidth": 780,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' http://wallpaper.localhost data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src http://wallpaper.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyMTU2MTQ4QTQzNTI4ODAKUldTQUtEV2tTR0VWZ2tyMFZWUFpDMkU1eFM1RG45RS9ReEJ5VjJlVDRKeTFKMXdCNlhld2xGRDcK",
      "endpoints": [
        "https://github.com/whoarei/wallpaper-box/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wallpaper Box",
    "shortDescription": "支持多显示器和模块切换的 Windows 动态壁纸程序",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../wallpapers/": "wallpapers/",
      "../../display-service/public/docs/architecture.html": "docs/architecture.html",
      "../../docs/wallpaper-adaptation.html": "docs/wallpaper-adaptation.html",
      "../resources/README.txt": "README.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
