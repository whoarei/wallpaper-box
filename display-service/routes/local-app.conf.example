# Copy to local-app.conf and adjust the route and upstream before enabling.
# The trailing slash strips /my-app/ before forwarding to the application.
# The application must support that base URL, or use a dedicated server block.
location /my-app/ {
    proxy_pass http://host.docker.internal:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
}
